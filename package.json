{
  "name": "vue-trend-chart",
  "productName": "Vue Trend Chart",
  "version": "0.17.0",
  "description": "Trend charts for Vue.js",
  "main": "dist/vue-trend-chart.umd.js",
  "module": "dist/vue-trend-chart.mjs",
  "types": "dist/index.d.ts",
  "unpkg": "dist/vue-trend-chart.umd.js",
  "jsdelivr": "dist/vue-trend-chart.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-trend-chart.mjs",
      "require": "./dist/vue-trend-chart.umd.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite-demo.config.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "lib:build": "vite build --config vite-lib.config.mts && vite build --config vite-lib.config.mts --mode umd && vue-tsc -p tsconfig.build.json",
    "lib:publish": "npm run typecheck && npm test && npm run lib:build && npm publish",
    "demo:build": "vite build --config vite-demo.config.mts",
    "demo:publish": "npm run demo:build && gh-pages -d demo-dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmtrbrl/vue-trend-chart.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "chart",
    "trend chart",
    "sparkline",
    "typescript"
  ],
  "author": "dmtrbrl <dmytro.barylo@gmail.com> (https://github.com/dmtrbrl)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dmtrbrl/vue-trend-chart/issues"
  },
  "homepage": "https://dmtrbrl.github.io/vue-trend-chart/",
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "dayjs": "^1.11.23",
    "gh-pages": "^6.3.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.106.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
